# ──────────────────────────────────────────────────────────────────────
# Backend Caltur – Workbook Paddle Billing
# Copiez ce fichier en .env et renseignez les vraies valeurs.
# Ne jamais commiter .env !
# ──────────────────────────────────────────────────────────────────────

# App
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# ── Stockage local ───────────────────────────────────────────────────
DATABASE_PATH=./data/orders.db

# ── Paddle Billing (Sandbox) ─────────────────────────────────────────
# Référence officielle : https://developer.paddle.com/api-reference/transactions/create-transaction
# Clé API Sandbox : Paddle > Developer tools > Authentication > Sandbox
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Jeton public de checkout (non secret) pour initialiser Paddle.js côté client.
# Paddle > Developer tools > Authentication > Client-side token. En sandbox,
# génère un jeton sandbox (test_clt_...) ; en production un jeton production.
PADDLE_CLIENT_TOKEN=
# Price ID du produit Workbook DVA dans votre catalogue Paddle (commence par pri_)
PADDLE_PRICE_ID=
# Devise du prix configuré dans Paddle (ex. USD). Le prix Sandbox est un prix
# de test ; ne pas le présenter comme l'équivalent de 199 MAD.
PADDLE_EXPECTED_CURRENCY=USD
# Montant attendu en centimes (optionnel — vide = ne pas vérifier le montant)
# Exemple : si le prix Sandbox est 29.99 USD → PADDLE_EXPECTED_AMOUNT_MINOR=2999
PADDLE_EXPECTED_AMOUNT_MINOR=
# URL d'un lien de paiement approuvé pour ce projet (optionnel).
# Si vide, Paddle utilise le lien par défaut du compte (⚠️ celui-ci pointe vers
# MinderCoach — ne pas le modifier). Pour éviter ce problème, créez un nouveau
# lien approuvé (Checkout > Checkout settings > Approved payment links) avec
# l'URL de votre domaine de workbook-site, puis remplissez ici.
PADDLE_CHECKOUT_URL=
# Clé secrète des webhooks (Paddle > Developer tools > Notifications)
PADDLE_WEBHOOK_SECRET=
# Fenêtre max (en secondes) pour accepter un webhook (protection replay)
WEBHOOK_MAX_AGE_SECONDS=300

# ── Liens protégés expirants ────────────────────────────────────────
ACCESS_LINK_SECRET=
# Durée de validité des liens en heures
ACCESS_LINK_TTL_HOURS=72

# ── Email / SMTP (pour la livraison automatique) ────────────────────
# Si ces valeurs manquent, la livraison reste en attente sans erreur
# visible côté client. Remplir pour activer l'envoi automatique.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Caltur
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# ── Fichiers livrés ────────────────────────────────────────────────
# Chemin absolu ou relatif ( depuis le dossier backend/ ) vers le PDF Workbook.
# Si le fichier n'existe pas, la livraison reste en attente.
DELIVERY_FILE_WORKBOOK=
# Lien live de la Masterclass (Zoom, Google Meet, etc.)
MASTERCLASS_URL=

# ── Admin ───────────────────────────────────────────────────────────
# Jeton imprévisible pour l'endpoint /api/status
# Générez avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_STATUS_TOKEN=

# ── Page locale (développement uniquement) ──────────────────────────
# Chemin vers index (6).html pour servir la page en lecture seule
HTML_PATH=../index (6).html